print("\n========== PARTE 3 - ANALISI CON NUMPY ==========")

# Generazione di 100 prezzi casuali tra 200 e 2000 euro
np.random.seed(42)

prezzi_prenotazioni = np.random.uniform(200, 2000, 100)

# Calcolo delle statistiche
prezzo_medio = np.mean(prezzi_prenotazioni)
prezzo_minimo = np.min(prezzi_prenotazioni)
prezzo_massimo = np.max(prezzi_prenotazioni)
deviazione_standard = np.std(prezzi_prenotazioni)

# Numero di prenotazioni sopra la media
prenotazioni_sopra_media = np.sum(
    prezzi_prenotazioni > prezzo_medio
)

# Percentuale di prenotazioni sopra la media
percentuale_sopra_media = (
    prenotazioni_sopra_media / len(prezzi_prenotazioni)
) * 100

print("Numero di prenotazioni:", len(prezzi_prenotazioni))
print("Prezzo medio:", round(prezzo_medio, 2), "euro")
print("Prezzo minimo:", round(prezzo_minimo, 2), "euro")
print("Prezzo massimo:", round(prezzo_massimo, 2), "euro")
print("Deviazione standard:", round(deviazione_standard, 2))
print("Prenotazioni sopra la media:", prenotazioni_sopra_media)
print("Percentuale sopra la media:", round(percentuale_sopra_media, 2), "%")


