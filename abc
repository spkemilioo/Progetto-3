    durata_media_categoria.index,
    durata_media_categoria.values,
    marker="o",
    label="Durata media"
)

ax2.set_ylabel("Durata media in giorni")

# Legenda combinata
linee1, etichette1 = ax1.get_legend_handles_labels()
linee2, etichette2 = ax2.get_legend_handles_labels()

ax1.legend(
    linee1 + linee2,
    etichette1 + etichette2,
    loc="upper right"
)

plt.tight_layout()
plt.show()


