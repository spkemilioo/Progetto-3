    "Categoria"
)["Durata"].mean()

# Creazione del grafico
fig, ax1 = plt.subplots(figsize=(10, 6))

# Grafico a barre: incasso medio
ax1.bar(
    incasso_medio_categoria.index,
    incasso_medio_categoria.values,
    alpha=0.7,
    label="Incasso medio"
)

ax1.set_xlabel("Categoria")
ax1.set_ylabel("Incasso medio in euro")
ax1.set_title("Incasso medio e durata media per categoria")

# Secondo asse verticale per la durata media
ax2 = ax1.twinx()

# Grafico a linee: durata media
