# Funzione che restituisce gli N clienti con più prenotazioni
def clienti_piu_attivi(dataframe, n):

    numero_prenotazioni = dataframe[
        "Cliente"
    ].value_counts()

    return numero_prenotazioni.head(n)


# Esempio: restituisce i 5 clienti con più prenotazioni
