print("\n========== PARTE 2 - PROGRAMMAZIONE AD OGGETTI ==========")


# Classe Cliente
class Cliente:

    def __init__(self, nome, eta, vip):
        self.nome = nome
        self.eta = eta
        self.vip = vip

    # Metodo per stampare le informazioni del cliente
    def informazioni(self):
        print("\nINFORMAZIONI CLIENTE")
        print("Nome:", self.nome)
        print("Età:", self.eta)
        print("Cliente VIP:", self.vip)


# Classe Viaggio
class Viaggio:

    def __init__(self, destinazione, prezzo, durata):
        self.destinazione = destinazione
        self.prezzo = prezzo
        self.durata = durata


# Classe Prenotazione
class Prenotazione:

    def __init__(self, cliente, viaggio):
        self.cliente = cliente
        self.viaggio = viaggio

    # Calcolo dell'importo finale
    def importo_finale(self):

        if self.cliente.vip:
            return self.viaggio.prezzo * 0.90

        return self.viaggio.prezzo

    # Metodo per stampare tutti i dettagli
    def dettagli(self):

        print("\nDETTAGLI PRENOTAZIONE")
        print("------------------------------")
        print("Cliente:", self.cliente.nome)
        print("Età:", self.cliente.eta)
        print("Destinazione:", self.viaggio.destinazione)
        print("Prezzo iniziale:", self.viaggio.prezzo, "euro")
        print("Durata:", self.viaggio.durata, "giorni")
        print("Cliente VIP:", self.cliente.vip)

        if self.cliente.vip:
            print("Sconto applicato: 10%")
        else:
            print("Sconto applicato: nessuno")

        print("Importo finale:", round(self.importo_finale(), 2), "euro")


# Creazione di alcuni clienti
